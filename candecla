<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="Gastos">
<meta name="theme-color" content="#0a0a0a">
<title>Gastos 2026</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
  :root {
    --bg: #0f0f0f;
    --surface: #1a1a1a;
    --surface2: #222222;
    --border: rgba(255,255,255,0.08);
    --text: #f0f0f0;
    --muted: rgba(240,240,240,0.4);
    --yellow: #FFD600;
    --yellow-bg: rgba(255,214,0,0.12);
    --yellow-border: rgba(255,214,0,0.3);
    --pink: #F48FB1;
    --pink-bg: rgba(244,143,177,0.12);
    --pink-border: rgba(244,143,177,0.3);
    --blue: #5B9BD5;
    --blue-bg: rgba(91,155,213,0.12);
    --success: #4CAF50;
    --error: #EF5350;
    --radius: 14px;
    --radius-sm: 10px;
  }

  * { box-sizing: border-box; margin: 0; padding: 0; -webkit-tap-highlight-color: transparent; }

  body {
    font-family: 'DM Sans', sans-serif;
    background: var(--bg);
    color: var(--text);
    min-height: 100vh;
    min-height: -webkit-fill-available;
    padding: env(safe-area-inset-top, 20px) env(safe-area-inset-right, 0) env(safe-area-inset-bottom, 0) env(safe-area-inset-left, 0);
    overflow-x: hidden;
  }

  .app {
    max-width: 430px;
    margin: 0 auto;
    padding: 24px 20px 40px;
  }

  .header {
    margin-bottom: 28px;
  }

  .header-top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 4px;
  }

  h1 {
    font-size: 26px;
    font-weight: 500;
    letter-spacing: -0.5px;
    color: var(--text);
  }

  .header-sub {
    font-size: 13px;
    color: var(--muted);
    font-family: 'DM Mono', monospace;
  }

  /* Grupo selector */
  .seg {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
    margin-bottom: 12px;
  }

  .seg-btn {
    padding: 13px 10px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--muted);
    font-size: 15px;
    font-family: 'DM Sans', sans-serif;
    font-weight: 400;
    cursor: pointer;
    transition: all 0.15s;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    -webkit-appearance: none;
  }

  .seg-btn .icon { font-size: 17px; }

  .seg-btn.active-casa {
    background: var(--blue-bg);
    border-color: var(--blue);
    color: var(--text);
  }

  .seg-btn.active-imprenta {
    background: rgba(180,130,255,0.1);
    border-color: rgba(180,130,255,0.5);
    color: var(--text);
  }

  /* Quien selector */
  .quien {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
    margin-bottom: 20px;
  }

  .quien-btn {
    padding: 13px 10px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--muted);
    font-size: 15px;
    font-family: 'DM Sans', sans-serif;
    cursor: pointer;
    transition: all 0.15s;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    -webkit-appearance: none;
  }

  .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .dot-c { background: var(--yellow); }
  .dot-d { background: var(--pink); }

  .quien-btn.active-claudio {
    background: var(--yellow-bg);
    border-color: var(--yellow-border);
    color: var(--text);
  }

  .quien-btn.active-deb {
    background: var(--pink-bg);
    border-color: var(--pink-border);
    color: var(--text);
  }

  /* Fields */
  .fields { display: flex; flex-direction: column; gap: 10px; margin-bottom: 16px; }

  .field {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 12px 15px;
    transition: border-color 0.15s;
  }

  .field:focus-within {
    border-color: rgba(255,255,255,0.2);
  }

  .field label {
    display: block;
    font-size: 11px;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.8px;
    margin-bottom: 5px;
    font-family: 'DM Mono', monospace;
  }

  .field input {
    width: 100%;
    background: transparent;
    border: none;
    outline: none;
    color: var(--text);
    font-size: 17px;
    font-family: 'DM Sans', sans-serif;
    font-weight: 400;
    -webkit-appearance: none;
    padding: 0;
  }

  .field input::placeholder { color: rgba(240,240,240,0.2); }

  .field input[type="date"] {
    color-scheme: dark;
  }

  .importe-row {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .importe-prefix {
    font-size: 17px;
    color: var(--muted);
    font-family: 'DM Mono', monospace;
  }

  /* Submit */
  .btn-submit {
    width: 100%;
    padding: 16px;
    border-radius: var(--radius);
    border: none;
    background: var(--text);
    color: var(--bg);
    font-size: 16px;
    font-family: 'DM Sans', sans-serif;
    font-weight: 500;
    cursor: pointer;
    transition: opacity 0.15s, transform 0.1s;
    margin-bottom: 16px;
    -webkit-appearance: none;
  }

  .btn-submit:active { transform: scale(0.98); opacity: 0.9; }
  .btn-submit:disabled { opacity: 0.3; }

  /* Toast */
  .toast {
    position: fixed;
    bottom: calc(env(safe-area-inset-bottom, 0px) + 24px);
    left: 50%;
    transform: translateX(-50%) translateY(100px);
    background: var(--surface2);
    border: 1px solid var(--border);
    color: var(--text);
    padding: 12px 20px;
    border-radius: 50px;
    font-size: 14px;
    font-weight: 500;
    transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
    white-space: nowrap;
    z-index: 100;
  }

  .toast.show { transform: translateX(-50%) translateY(0); }
  .toast.ok { border-color: rgba(76,175,80,0.4); color: #81C784; }
  .toast.err { border-color: rgba(239,83,80,0.4); color: #EF9A9A; }
  .toast.loading { border-color: var(--border); color: var(--muted); }

  /* Recientes */
  .section-title {
    font-size: 11px;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.8px;
    font-family: 'DM Mono', monospace;
    margin-bottom: 10px;
  }

  .recientes-list { display: flex; flex-direction: column; gap: 6px; }

  .gasto-item {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 12px 14px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .gasto-item.claudio { border-left: 3px solid var(--yellow); }
  .gasto-item.deb { border-left: 3px solid var(--pink); }

  .gasto-info {}
  .gasto-concepto { font-size: 15px; color: var(--text); }
  .gasto-meta { font-size: 12px; color: var(--muted); margin-top: 2px; font-family: 'DM Mono', monospace; }
  .gasto-importe { font-size: 16px; font-weight: 500; font-family: 'DM Mono', monospace; color: var(--text); }

  /* Divider */
  .divider { border: none; border-top: 1px solid var(--border); margin: 24px 0; }

  /* Config */
  .config-toggle {
    background: none;
    border: none;
    color: var(--muted);
    font-size: 13px;
    font-family: 'DM Mono', monospace;
    cursor: pointer;
    padding: 0;
    margin-bottom: 12px;
    -webkit-appearance: none;
  }

  .config-box {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 14px;
    display: none;
  }

  .config-box.open { display: block; }

  .config-box label {
    display: block;
    font-size: 11px;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.8px;
    font-family: 'DM Mono', monospace;
    margin-bottom: 7px;
  }

  .config-row { display: flex; gap: 8px; }

  .config-row input {
    flex: 1;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 10px 12px;
    color: var(--text);
    font-size: 12px;
    font-family: 'DM Mono', monospace;
    outline: none;
    -webkit-appearance: none;
  }

  .btn-ok {
    background: var(--surface2);
    border: 1px solid var(--border);
    border-radius: 8px;
    color: var(--text);
    font-size: 13px;
    font-family: 'DM Sans', sans-serif;
    padding: 10px 16px;
    cursor: pointer;
    -webkit-appearance: none;
  }
</style>
</head>
<body>
<div class="app">

  <div class="header">
    <div class="header-top">
      <h1>Gastos 2026</h1>
    </div>
    <div class="header-sub" id="status-label">listo</div>
  </div>

  <!-- Grupo -->
  <div class="seg">
    <button class="seg-btn active-casa" id="btn-casa" onclick="setGrupo('casa')">
      <span class="icon">🏠</span> Casa
    </button>
    <button class="seg-btn" id="btn-imprenta" onclick="setGrupo('imprenta')">
      <span class="icon">🖨️</span> Imprenta
    </button>
  </div>

  <!-- Quien -->
  <div class="quien">
    <button class="quien-btn active-claudio" id="btn-claudio" onclick="setQuien('claudio')">
      <span class="dot dot-c"></span> Claudio
    </button>
    <button class="quien-btn" id="btn-deb" onclick="setQuien('deb')">
      <span class="dot dot-d"></span> Deb
    </button>
  </div>

  <!-- Fields -->
  <div class="fields">
    <div class="field">
      <label>Fecha</label>
      <input type="date" id="fecha" />
    </div>
    <div class="field">
      <label>Concepto</label>
      <input type="text" id="concepto" placeholder="super, nafta, farmacia…" autocomplete="off" autocorrect="off" />
    </div>
    <div class="field">
      <label>Importe</label>
      <div class="importe-row">
        <span class="importe-prefix">$</span>
        <input type="number" id="importe" placeholder="0" inputmode="numeric" min="0" step="1" />
      </div>
    </div>
  </div>

  <button class="btn-submit" id="btn-guardar" onclick="guardar()">Guardar gasto</button>

  <!-- Recientes -->
  <div id="recientes-section" style="display:none">
    <p class="section-title">Últimos cargados</p>
    <div class="recientes-list" id="lista"></div>
    <hr class="divider">
  </div>

  <!-- Config -->
  <button class="config-toggle" onclick="toggleConfig()">⚙ configuración</button>
  <div class="config-box" id="config-box">
    <label>URL del script</label>
    <div class="config-row">
      <input type="text" id="script-url" placeholder="https://script.google.com/macros/s/…/exec" />
      <button class="btn-ok" onclick="guardarConfig()">OK</button>
    </div>
  </div>

</div>

<div class="toast" id="toast"></div>

<script>
const SK = 'gastos26';
let scriptUrl = 'https://script.google.com/macros/s/AKfycbwHHWfs-WiYhkzLfVWcPAv06n-JB1OYRhAaNlW4BrH6V3oBvOZA0Mya4ony0yPncmdtsg/exec';
let grupo = 'casa';
let quien = 'claudio';
let recientes = [];
let toastTimer;

function hoy() {
  return new Date().toISOString().split('T')[0];
}

function init() {
  try {
    const c = JSON.parse(localStorage.getItem(SK) || '{}');
    if (c.scriptUrl) scriptUrl = c.scriptUrl;
    recientes = c.recientes || [];
  } catch(e) {}
  document.getElementById('fecha').value = hoy();
  document.getElementById('script-url').value = scriptUrl;
  actualizarStatus();
  renderRecientes();
}

function actualizarStatus() {
  document.getElementById('status-label').textContent = scriptUrl ? 'conectado' : 'configurar script ↓';
}

function guardarConfig() {
  const v = document.getElementById('script-url').value.trim();
  if (v) { scriptUrl = v; save(); actualizarStatus(); toast('ok', 'URL guardada'); }
}

function toggleConfig() {
  document.getElementById('config-box').classList.toggle('open');
}

function setGrupo(g) {
  grupo = g;
  document.getElementById('btn-casa').className = 'seg-btn' + (g==='casa' ? ' active-casa' : '');
  document.getElementById('btn-imprenta').className = 'seg-btn' + (g==='imprenta' ? ' active-imprenta' : '');
}

function setQuien(q) {
  quien = q;
  document.getElementById('btn-claudio').className = 'quien-btn' + (q==='claudio' ? ' active-claudio' : '');
  document.getElementById('btn-deb').className = 'quien-btn' + (q==='deb' ? ' active-deb' : '');
}

function toast(tipo, msg) {
  const el = document.getElementById('toast');
  el.className = 'toast ' + tipo;
  el.textContent = msg;
  el.classList.add('show');
  clearTimeout(toastTimer);
  if (tipo !== 'loading') toastTimer = setTimeout(() => el.classList.remove('show'), 3000);
}

function save() {
  localStorage.setItem(SK, JSON.stringify({ scriptUrl, recientes }));
}

function renderRecientes() {
  const sec = document.getElementById('recientes-section');
  const lista = document.getElementById('lista');
  if (!recientes.length) { sec.style.display = 'none'; return; }
  sec.style.display = 'block';
  lista.innerHTML = recientes.slice(-5).reverse().map(g => `
    <div class="gasto-item ${g.quien}">
      <div class="gasto-info">
        <div class="gasto-concepto">${g.concepto}</div>
        <div class="gasto-meta">${g.fecha} · ${g.grupo === 'casa' ? '🏠' : '🖨️'}</div>
      </div>
      <div class="gasto-importe">$${Number(g.importe).toLocaleString('es-AR')}</div>
    </div>
  `).join('');
}

async function guardar() {
  const fecha = document.getElementById('fecha').value;
  const concepto = document.getElementById('concepto').value.trim();
  const importe = document.getElementById('importe').value.trim();

  if (!scriptUrl) { toast('err', 'Configurá la URL del script'); return; }
  if (!fecha) { toast('err', 'Falta la fecha'); return; }
  if (!concepto) { toast('err', 'Falta el concepto'); return; }
  if (!importe || isNaN(Number(importe))) { toast('err', 'Importe inválido'); return; }

  const btn = document.getElementById('btn-guardar');
  btn.disabled = true;
  toast('loading', 'Guardando…');

  try {
    const url = `${scriptUrl}?fecha=${encodeURIComponent(fecha)}&concepto=${encodeURIComponent(concepto)}&importe=${Number(importe)}&grupo=${grupo}&quien=${quien}`;
    const resp = await fetch(url);
    const data = await resp.json();

    if (data.ok) {
      recientes.push({ fecha, concepto, importe: Number(importe), grupo, quien });
      if (recientes.length > 20) recientes = recientes.slice(-20);
      save();
      renderRecientes();
      document.getElementById('concepto').value = '';
      document.getElementById('importe').value = '';
      document.getElementById('fecha').value = hoy();
      toast('ok', quien === 'deb' ? '✓ Guardado 🌸' : '✓ Guardado ⭐');
    } else {
      throw new Error(data.error || 'Error en el script');
    }
  } catch(e) {
    toast('err', 'Error: ' + e.message);
  }
  btn.disabled = false;
}

init();
</script>
</body>
</html>
